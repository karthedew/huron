# Development values only. Nothing here is a secret.
# The API's environment for `make migrate` and `make api` on the host and for the API containers of
# docker-compose.app.yml, which share one network namespace so 127.0.0.1 means the same there.
# The API's other settings live in huron.dev.yaml, the one file to edit; a HURON_* variable added
# here wins over that file, so add one only to override it.
# Never load this file into the CLI's environment: to the CLI HURON_API_URL and HURON_ISSUER are
# its own settings.
HURON_DATABASE_URL=postgresql://huron:huron@127.0.0.1:5432/huron
HURON_API_URL=http://127.0.0.1:8080
# The service configuration, with the declared organizations: relative to the repository root for
# `make api`; the API container of `make app` mounts the same file and sets its own path.
HURON_CONFIG_FILE=huron.dev.yaml
