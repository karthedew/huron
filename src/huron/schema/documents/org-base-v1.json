{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organization base",
  "type": "object",
  "required": [
    "title",
    "pi",
    "contact"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human title"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "pi": {
      "type": "string",
      "minLength": 1,
      "description": "Principal investigator"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "$ref": "#/$defs/email"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "email": {
      "type": "string",
      "format": "email"
    }
  }
}
