[
  {
    "command": [
      "uv",
      "run",
      "mypy"
    ],
    "exit": 0,
    "log": "delivery-types-mypy.log"
  },
  {
    "command": [
      "uv",
      "run",
      "ty",
      "check"
    ],
    "exit": 0,
    "log": "delivery-types-ty.log"
  },
  {
    "command": [
      "uv",
      "run",
      "pydoclint",
      "src",
      "migrations",
      "scripts"
    ],
    "exit": 0,
    "log": "delivery-pydoclint.log"
  },
  {
    "command": [
      "uv",
      "run",
      "radon",
      "cc",
      "src/huron",
      "--min",
      "C"
    ],
    "exit": 0,
    "log": "delivery-radon-cc.log"
  },
  {
    "command": [
      "uv",
      "run",
      "radon",
      "mi",
      "src/huron",
      "--min",
      "B"
    ],
    "exit": 0,
    "log": "delivery-radon-mi.log"
  },
  {
    "command": [
      "uv",
      "run",
      "complexipy",
      "src/huron",
      "--max-complexity-allowed",
      "15"
    ],
    "exit": 0,
    "log": "delivery-complexipy.log"
  },
  {
    "command": [
      "uv",
      "run",
      "--locked",
      "pyscn",
      "check",
      "src/huron"
    ],
    "exit": 0,
    "log": "delivery-pyscn-check.log"
  },
  {
    "command": [
      "uv",
      "run",
      "--locked",
      "python",
      "scripts/check_duplication.py",
      "src/huron"
    ],
    "exit": 1,
    "log": "delivery-native-huron.log"
  },
  {
    "command": [
      "uv",
      "run",
      "--locked",
      "pyscn",
      "analyze",
      "--json",
      "src"
    ],
    "exit": 0,
    "log": "delivery-full-src.log"
  },
  {
    "command": [
      "uv",
      "run",
      "--locked",
      "python",
      "scripts/check_duplication.py",
      "src"
    ],
    "exit": 1,
    "log": "delivery-native-src.log"
  }
]
