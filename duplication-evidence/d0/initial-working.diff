-    def __call__(self, token: str) -> Mapping[str, object]:
-        import jwt
-
-        try:
-            key = self._jwks.get_signing_key_from_jwt(token).key
-            return jwt.decode(
-                token,
-                key,
-                algorithms=["RS256", "ES256"],
-                issuer=self.issuer,
-                audience=self.audience,
-                options={"require": ["exp", "iat", "sub"]},
