{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huron:schema:catalog-config-v1",
  "type": "object",
  "required": [
    "catalog",
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "#/$defs/segment",
      "title": "Catalog",
      "description": "Strict catalog identifier."
    },
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "readOnly": true,
      "title": "Configuration version",
      "description": "Server-assigned version on a stored configuration receipt."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Title",
      "description": "Optional display title."
    },
    "schema": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "title": "Metadata schema",
      "description": "Exact metadata schema selected for this catalog.",
      "properties": {
        "name": {
          "$ref": "#/$defs/segment",
          "title": "Schema name",
          "description": "Strict metadata schema identifier."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "title": "Schema version",
          "description": "Exact positive metadata schema version."
        }
      }
    },
    "snapshot_class": {
      "$ref": "#/$defs/segment",
      "title": "Snapshot policy",
      "description": "Optional operator policy label; Huron does not enforce snapshot retention."
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    }
  }
}
