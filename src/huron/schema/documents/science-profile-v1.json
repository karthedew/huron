{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huron:science-profile:1",
  "type": "object",
  "required": ["schema", "name", "version", "files", "canonical_contract"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "urn:huron:science-profile:1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "retention_category"],
        "additionalProperties": false,
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "retention_category": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": false}
        }
      }
    },
    "canonical_contract": {"type": "object"}
  }
}
