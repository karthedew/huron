{
  "realm": "company",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "huron-cli",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:*/callback",
        "http://127.0.0.1/*"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "huron-cli",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "huron-web",
      "name": "Huron web (development)",
      "description": "The web app's confidential client. Its secret is a development value, never a real one.",
      "publicClient": false,
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "huron-web-dev-only-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://127.0.0.1:3000/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:4173/auth/callback",
        "http://127.0.0.1:4173/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login?status=signed-out##http://127.0.0.1:3000/login?status=signed-out##http://localhost:5173/login?status=signed-out##http://127.0.0.1:5173/login?status=signed-out##http://localhost:4173/login?status=signed-out##http://127.0.0.1:4173/login?status=signed-out"
      },
      "protocolMappers": [
        {
          "name": "huron-cli audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "huron-cli",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
