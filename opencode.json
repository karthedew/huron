{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "markdown-orchestrator",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".agents/skills", "~/.agents/skills/writing-for-agents", ".claude/skills/asd-ste100"]
  },
  "permission": {
    "skill": {
      "*": "deny",
      "oop-design": "allow",
      "fastapi": "allow",
      "postgresql-table-design": "allow",
      "svelte-code-writer": "allow",
      "svelte-core-bestpractices": "allow",
      "tailwind-design-system": "allow",
      "playwright-cli": "allow",
      "huron-design-plan": "allow",
      "huron-prototype": "allow",
      "huron-implementation-plan": "allow",
      "huron-implement-markdown": "allow",
      "customize-opencode": "allow",
      "writing-for-agents": "allow",
      "asd-ste100": "allow"
    }
  },
  "plugin": ["./.agents/plugins/implementation.ts"],
  "command": {
    "design-plan": {
      "description": "Verify design claims and plan a local roadmap with prototype questions.",
      "agent": "markdown-orchestrator",
      "template": "{file:./.agents/commands/design-plan.md}"
    },
    "prototype": {
      "description": "Resolve a bounded design question with local throwaway evidence.",
      "agent": "markdown-orchestrator",
      "template": "{file:./.agents/commands/prototype.md}"
    },
    "implementation-plan": {
      "description": "Write and independently review self-contained executable phase plans.",
      "agent": "markdown-orchestrator",
      "template": "{file:./.agents/commands/implementation-plan.md}"
    },
    "implement-markdown": {
      "description": "Execute a markdown plan with exclusive Astra Medium code workers and final Max qualification.",
      "agent": "markdown-orchestrator",
      "model": "openai/gpt-6-astra",
      "variant": "low",
      "template": "{file:./.agents/commands/implement-markdown.md}"
    }
  },
  "agent": {
    "markdown-orchestrator": {
      "description": "Orchestrates delegated discovery, planning, prototypes, implementation and independent review.",
      "prompt": "{file:./.agents/prompts/orchestrator.md}",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "low",
      "options": { "reasoningEffort": "low" },
      "permission": { "task": "deny" }
    },
    "markdown-implementer": {
      "description": "Writes one assigned plan, prototype, implementation or fix slice; never delegates.",
      "prompt": "{file:./.agents/prompts/implementer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "low",
      "options": { "reasoningEffort": "low" },
      "permission": { "task": "deny", "implementation_start": "deny" }
    },
    "markdown-implementer-medium": {
      "description": "Implements or fixes one exclusive code slice with Astra Medium. Never delegates.",
      "prompt": "{file:./.agents/prompts/implementer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "medium",
      "options": { "reasoningEffort": "medium" },
      "permission": { "task": "deny", "implementation_start": "deny" }
    },
    "markdown-reviewer-medium": {
      "description": "Independently reviews one assigned slice with Astra Medium. Stays read-only. Does not provide final qualification.",
      "prompt": "{file:./.agents/prompts/reviewer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "medium",
      "options": { "reasoningEffort": "medium" },
      "permission": { "edit": "deny", "task": "deny", "implementation_start": "deny" }
    },
    "markdown-implementer-max": {
      "description": "Implements or fixes one exclusive code slice with Astra Max; never delegates.",
      "prompt": "{file:./.agents/prompts/implementer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "max",
      "options": { "reasoningEffort": "max" },
      "permission": { "task": "deny", "implementation_start": "deny" }
    },
    "markdown-reviewer-max": {
      "description": "Independently performs complete qualification with Astra Max; read-only.",
      "prompt": "{file:./.agents/prompts/reviewer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "max",
      "options": { "reasoningEffort": "max" },
      "permission": { "edit": "deny", "task": "deny", "implementation_start": "deny" }
    },
    "markdown-reviewer": {
      "description": "Independently verifies one markdown-plan slice and runs its full gate.",
      "prompt": "{file:./.agents/prompts/reviewer.md}",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "low",
      "options": { "reasoningEffort": "low" },
      "permission": { "edit": "deny", "task": "deny", "implementation_start": "deny" }
    }
  }
}
