### lakectl protocol cutover --help
usage: lakectl protocol cutover [-h] (--prepare | --validate) --config CONFIG
                                [--run-id RUN_ID] [--sequence SEQUENCE]

options:
  -h, --help           show this help message and exit
  --prepare
  --validate
  --config CONFIG
  --run-id RUN_ID
  --sequence SEQUENCE
exit=0

### --prepare without --run-id
usage: lakectl protocol cutover [-h] (--prepare | --validate) --config CONFIG
                                [--run-id RUN_ID] [--sequence SEQUENCE]
lakectl protocol cutover: error: --prepare takes --run-id and --validate takes --sequence
exit=2

### both flags
usage: lakectl protocol cutover [-h] (--prepare | --validate) --config CONFIG
                                [--run-id RUN_ID] [--sequence SEQUENCE]
lakectl protocol cutover: error: argument --validate: not allowed with argument --prepare
exit=2

### --sequence 0
usage: lakectl protocol cutover [-h] (--prepare | --validate) --config CONFIG
                                [--run-id RUN_ID] [--sequence SEQUENCE]
lakectl protocol cutover: error: argument --sequence: sequence must be between 1 and 999999
exit=2

### lakectl --help
usage: lakectl [-h] {controller,restart,protocol} ...

positional arguments:
  {controller,restart,protocol}

options:
  -h, --help            show this help message and exit
exit=0
