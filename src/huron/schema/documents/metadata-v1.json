{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huron:metadata:1",
  "type": "object",
  "required": ["schema", "organization", "project", "dataset", "revision_number", "title", "creators", "committed_by", "committed_at", "data_classification", "manifest_sha256"],
  "properties": {
    "schema": {"const": "urn:huron:metadata:1"},
    "organization": {"$ref": "#/$defs/ref"},
    "project": {"$ref": "#/$defs/ref"},
    "dataset": {"$ref": "#/$defs/ref"},
    "revision_number": {"type": "integer", "minimum": 1, "maximum": 999999},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "creators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "committed_by": {"type": "string", "minLength": 1},
    "committed_at": {"type": "string", "format": "date-time"},
    "data_classification": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source": {"type": "object"},
    "coverage": {"type": "object"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["id", "slug"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}
      }
    }
  }
}
