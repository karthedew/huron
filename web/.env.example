# Settings of the Huron web server for the development stack: `make up` (PostgreSQL, and Keycloak's
# realm `company` on 127.0.0.1:8081) with `make api` (the API on 127.0.0.1:8080). Copy this file
# to `.env`, which `npm run start` and `npm run dev` read; README.md walks through it. An empty
# value counts as unset. In production every setting is an environment variable instead.

# Where browsers reach the web.
# The public origin, without a path; required outside `vite dev`, which uses each request's own
# origin. Sign-in returns to <ORIGIN>/auth/callback, which the IdP must list exactly: the dev
# realm's huron-web client lists ports 3000, 5173 and 4173 on localhost and 127.0.0.1. Open the
# web at exactly this origin. On https every cookie is Secure and __Host- prefixed.
ORIGIN=http://localhost:3000
# Where `npm run start` (adapter-node) listens; ORIGIN must lead here. 3000 is free while
# `make up` runs: `make app` uses it, and the two stacks never run together. 4173 belongs to
# `npm run test:e2e`, 5173 to `npm run dev` and `npm run demo`.
HOST=127.0.0.1
PORT=3000

# The Huron API.
# The API origin, without a path; the web appends /api/v1.
HURON_API_URL=http://127.0.0.1:8080
# Milliseconds to wait for an API read or an IdP call (default 10000); the token exchange waits
# max(35000, 3 x this).
HURON_WEB_API_TIMEOUT_MS=10000

# The company OIDC provider.
# Its issuer, byte for byte the API's HURON_COMPANY_ISSUER (dev.env). Use 127.0.0.1: the Keycloak
# of `make up` names itself after the host it is asked by.
HURON_WEB_OIDC_ISSUER=http://127.0.0.1:8081/realms/company
# The web's client. Its ID tokens must also carry the API's HURON_COMPANY_AUDIENCE (huron-cli) in
# `aud`; the dev realm's audience mapper adds it.
HURON_WEB_OIDC_CLIENT_ID=huron-web
# The client's secret, sent as client_secret_basic; leave it unset for a public client. This is
# the development secret of the dev realm's confidential huron-web client
# (scripts/keycloak/company-realm.json), never a real one: without it Keycloak refuses the token
# request, and sign-in ends at error=idp_error.
HURON_WEB_OIDC_CLIENT_SECRET=huron-web-dev-only-secret
# The scopes sign-in asks for, separated by spaces; they must include openid (default
# openid profile email).
HURON_WEB_OIDC_SCOPES=openid profile email
# true (default): signing out of the web goes on to the IdP's end_session_endpoint, when the IdP
# advertises one, and ends its session too; false: sign out of the web alone.
HURON_WEB_OIDC_LOGOUT=true

# What pages show.
# Where the share is mounted (default /projects/huron): share paths read <prefix>/<path>. Set it
# to the CLI's mount_prefix to see the paths of your own share.
HURON_WEB_MOUNT_PREFIX=/projects/huron
