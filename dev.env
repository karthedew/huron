# Development configuration for the Huron API - the HURON_* variables
# ApiSettings (src/huron/service/api/settings.py) reads.
#
# Two consumers, one file:
#   - on the host:  `make api` and `make migrate` run under
#                   `uv run --env-file dev.env ...`; a variable already set in
#                   your shell takes precedence over the value here.
#   - in compose:   the `api` service loads it through `env_file` and overrides
#                   only HURON_DATABASE_URL, because Postgres is reached as
#                   postgres:5432 inside the compose network and localhost:5433
#                   from the host.
#
# Every value is a development-only literal for the local compose stack that
# nothing outside this machine can reach; none is a real credential. The JSON
# value is single-quoted so uv, docker compose and podman-compose all read it
# byte for byte.
HURON_ENV=development
HURON_AUTH_MODE=oidc
HURON_DATABASE_URL=postgresql://huron:huron@localhost:5433/huron
HURON_DATA_ROOT=.data
HURON_OIDC__ISSUER=http://keycloak:8081/realms/huron
HURON_OIDC__CLIENT_ID=huron-web
HURON_OIDC__CLIENT_SECRET=dev-only-secret
HURON_OIDC__REDIRECT_URL=http://localhost:8080/auth/oidc/callback
HURON_LOGIN_FLOW_SECRET=dev-only-flow-secret
HURON_WEB_APP_URL=http://localhost:5173
HURON_BOOTSTRAP_PLATFORM_OWNER=karl
HURON_CLASSIFICATION_VOCABULARY='[{"code":"internal","order":0,"discoverable":true}]'
