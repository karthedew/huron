# Development values only. Nothing here is a secret.
# The API's settings, for `make migrate` and `make api` on the host and for the API containers of
# docker-compose.app.yml, which share one network namespace so 127.0.0.1 means the same there.
# Never load this file into the CLI's environment: to the CLI HURON_ISSUER means the company IdP,
# here it is the API's own token issuer.
HURON_DATABASE_URL=postgresql://huron:huron@127.0.0.1:5432/huron
HURON_STORE=postgres
HURON_INSTANCE_ID=0192b6a0-0000-7000-8000-000000000001
HURON_ISSUER=http://127.0.0.1:8080
HURON_AUDIENCE=huron
HURON_COMPANY_ISSUER=http://127.0.0.1:8081/realms/company
HURON_COMPANY_AUDIENCE=huron-cli
HURON_GROUP_DIRECTORY_URL=http://127.0.0.1:8082
HURON_PLATFORM_ADMIN_GROUP=huron-platform-admins
HURON_API_URL=http://127.0.0.1:8080
