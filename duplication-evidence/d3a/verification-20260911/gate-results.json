{
  "docs": 0,
  "duplication-src": 1,
  "lint": 2,
  "contract": 0,
  "unit": 0,
  "diff-check": 0,
  "integration": 0,
  "make lint constituent exits": {
    "ruff check .": 0,
    "ruff format --check .": 0,
    "pydoclint src migrations scripts": 0,
    "mypy": 0,
    "ty check": 0,
    "lint-imports": 0,
    "python scripts/check_schema_map.py": 0,
    "radon cc src/huron --min C": 0,
    "radon mi src/huron --min B": 0,
    "complexipy src/huron --max-complexity-allowed 15": 0,
    "pyscn check src/huron": 0,
    "python scripts/check_duplication.py src/huron": 1
  }
}