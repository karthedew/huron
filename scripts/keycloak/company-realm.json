{
  "realm": "company",
  "displayName": "Company IdP (local mock)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "huron-cli",
      "name": "Huron CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": ["http://127.0.0.1/*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "claim.value": "Huron Development",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6f1c1a3e-0000-4000-8000-000000000001",
      "username": "karl",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Karl",
      "lastName": "Owner",
      "email": "karl@company.test",
      "credentials": [{"type": "password", "value": "karl-dev-password", "temporary": false}]
    },
    {
      "id": "6f1c1a3e-0000-4000-8000-000000000002",
      "username": "sam",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Developer",
      "email": "sam@company.test",
      "credentials": [{"type": "password", "value": "sam-dev-password", "temporary": false}]
    },
    {
      "id": "6f1c1a3e-0000-4000-8000-000000000003",
      "username": "rita",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rita",
      "lastName": "Reader",
      "email": "rita@company.test",
      "credentials": [{"type": "password", "value": "rita-dev-password", "temporary": false}]
    }
  ]
}
