# Server-only Polaris origin. No URL path, query or embedded credentials.
POLARIS_URL=http://127.0.0.1:8181
POLARIS_REALM=POLARIS

# Local bootstrap file. For another endpoint use a private JSON file containing
# {"clientId":"...","clientSecret":"..."}, or the two environment variables below.
POLARIS_BOOTSTRAP_CREDENTIALS_FILE=../.local/polaris/credentials.json
# POLARIS_BOOTSTRAP_CLIENT_ID=
# POLARIS_BOOTSTRAP_CLIENT_SECRET=

# Additional organization roots: provision realms in Polaris first, include them in
# polaris.realm-context.realms, then add server-only root connections here.
# Realm names must be unique in this registry. Credentials never reach the browser.
# POLARIS_CONNECTIONS_JSON='[{"realm":"RESEARCH","url":"http://127.0.0.1:8181","clientId":"research-root","clientSecret":"replace-with-private-secret"}]'

# Persist this directory and its private encryption key when deploying.
# One deployment store holds global Huron logins and separate credentials per realm.
HURON_ACCOUNT_STORE=../.local/huron/accounts.json
# Optional INITIAL administrator password; later resets use Huron admin/account settings.
# HURON_ADMIN_PASSWORD=
HURON_ALLOW_SIGNUP=false

# Read-only Icechunk schema/history inspector. Paths are relative to web/.
# Mount only repository storage that this server is allowed to inspect.
HURON_ICECHUNK_PYTHON=../.local/polaris/icechunk-venv/bin/python
HURON_ICECHUNK_READ_ROOTS=../.local/polaris/nasa-storage:../.local/polaris/storage

# adapter-node production origin, matching the public URL used by browsers.
# ORIGIN=https://huron.example.org
# HOST=127.0.0.1
# PORT=3000
# npm start defaults to one 64 MiB Raw part; an explicit value overrides that limit.
# BODY_SIZE_LIMIT=67108864

# Organization membership and immutable Polaris realm bindings (defaults beside HURON_ACCOUNT_STORE).
# HURON_ORGANIZATION_STORE=../.local/huron/organizations.json

# Raw publication service. Both services must share the same private key (32+ bytes).
# scripts/polaris-dev.sh supplies these for local development; keep them server-only.
# HURON_RAW_API_URL=http://127.0.0.1:8080
# HURON_RAW_BRIDGE_SECRET=
# Native Polaris RBAC is the supported Raw authorization mode; other modes fail closed.
# HURON_RAW_POLARIS_AUTHORIZATION=rbac
