diff --git a/src/huron/core/catalog_collections.py b/src/huron/core/catalog_collections.py
new file mode 100644
index 0000000..f545db3
--- /dev/null
+++ b/src/huron/core/catalog_collections.py
@@ -0,0 +1,102 @@
+"""Typed actor-bound catalog discovery with current authority on every operation."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+from huron.pkg.catalog.persistence import PlatformRoot
+from huron.pkg.catalog.records import Dataset, Organization, Project
+from huron.pkg.rbac import ScopeType
+
+if TYPE_CHECKING:
+    from huron.pkg.catalog.persistence import Window
+
+    from .access import AccessPolicy
+    from .catalog_ports import CatalogReaders, CollectionReader
+
+
+class _Collection[ItemT, ParentT: (PlatformRoot, UUID)]:
+    """A fixed reader and parent scope, selected together by concrete construction."""
+
+    def __init__(
+        self, access: AccessPolicy, reader: CollectionReader[ItemT, ParentT], parent_kind: ScopeType
+    ) -> None:
+        """Bind the fixed reader and parent discovery rule.
+
+        Args:
+            access: Current actor authority.
+            reader: The concrete typed resource reader.
+            parent_kind: The fixed owning resource scope.
+        """
+        self._access = access
+        self._reader: CollectionReader[ItemT, ParentT] = reader
+        self._parent_kind = parent_kind
+
+    async def get(self, resource_id: UUID) -> ItemT:
+        """Discover an entity with the authenticated actor's current visibility.
+
+        Args:
+            resource_id: The addressed resource's identifier.
+
+        Returns:
+            The entity; hidden and absent identifiers raise ResourceNotFound.
+        """
+        return await self._reader.get(resource_id, await self._access.visibility())
+
+    async def browse(
+        self, parent: ParentT, *, limit: int, after: tuple[str, UUID] | None
+    ) -> Window[ItemT]:
+        """Discover the parent before requesting its visible keyset window.
+
+        Args:
+            parent: The owning resource or explicit platform root.
+            limit: Maximum number of returned entities.
+            after: Exclusive slug and UUID cursor.
+
+        Returns:
+            A visible window; hidden or absent parents raise ResourceNotFound.
+        """
+        visibility = await self._access.visibility()
+        if not isinstance(parent, PlatformRoot):
+            await self._access._resolve_scope(self._parent_kind, parent, visibility)
+        return await self._reader.browse(parent, visibility, limit=limit, after=after)
+
+
+class OrganizationCollection(_Collection[Organization, PlatformRoot]):
+    """Organization discovery at the platform root."""
+
+    def __init__(self, access: AccessPolicy, readers: CatalogReaders) -> None:
+        """Bind organization reads to the platform parent.
+
+        Args:
+            access: Authenticated actor and current authorization facts.
+            readers: Typed committed hierarchy readers.
+        """
+        super().__init__(access, readers.organizations, ScopeType.SYSTEM)
+
+
+class ProjectCollection(_Collection[Project, UUID]):
+    """Project discovery beneath an admitted organization."""
+
+    def __init__(self, access: AccessPolicy, readers: CatalogReaders) -> None:
+        """Bind project reads to organization discovery.
+
+        Args:
+            access: Authenticated actor and current authorization facts.
+            readers: Typed committed hierarchy readers.
+        """
+        super().__init__(access, readers.projects, ScopeType.ORGANIZATION)
+
+
+class DatasetCollection(_Collection[Dataset, UUID]):
+    """Dataset discovery beneath an admitted project."""
+
+    def __init__(self, access: AccessPolicy, readers: CatalogReaders) -> None:
+        """Bind dataset reads to project discovery.
+
+        Args:
+            access: Authenticated actor and current authorization facts.
+            readers: Typed committed hierarchy readers.
+        """
+        super().__init__(access, readers.datasets, ScopeType.PROJECT)
diff --git a/src/huron/core/catalog_ports.py b/src/huron/core/catalog_ports.py
new file mode 100644
index 0000000..a2b4fe2
--- /dev/null
+++ b/src/huron/core/catalog_ports.py
@@ -0,0 +1,135 @@
+"""Consumer-owned catalog reads and current authorization facts."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Protocol
+
+if TYPE_CHECKING:
+    from uuid import UUID
+
+    from huron.pkg.catalog.persistence import PlatformRoot, Window
+    from huron.pkg.catalog.records import Dataset, Organization, Project, ServiceAccount
+    from huron.pkg.rbac import Binding, ProjectVisibility, Visibility
+
+
+class CollectionReader[ItemT, ParentT](Protocol):
+    """Discoverable point reads and visible keyset windows of one fixed entity kind."""
+
+    async def get(self, resource_id: UUID, visibility: Visibility) -> ItemT:
+        """Read one admitted resource or raise ResourceNotFound.
+
+        Args:
+            resource_id: The exact resource to resolve.
+            visibility: Discovery rights, applied before returning the record.
+
+        Returns:
+            The stored entity, preserving its concrete type.
+        """
+        ...
+
+    async def browse(
+        self,
+        parent: ParentT,
+        visibility: Visibility,
+        *,
+        limit: int,
+        after: tuple[str, UUID] | None,
+    ) -> Window[ItemT]:
+        """Page visible children using C-collated slug and UUID ordering.
+
+        The caller checks parent discovery. Filtering precedes limiting, and
+        has_more counts only visible records; absent parents yield no rows.
+
+        Args:
+            parent: The owning resource, or the explicit platform root.
+            visibility: The caller's discovery rights.
+            limit: Maximum returned records.
+            after: Exclusive slug and UUID cursor, or None for the first page.
+
+        Returns:
+            The visible window with an accurate further-row flag.
+        """
+        ...
+
+
+class CatalogReaders(Protocol):
+    """The fixed typed readers needed to resolve authoritative hierarchy ancestry."""
+
+    @property
+    def organizations(self) -> CollectionReader[Organization, PlatformRoot]:
+        """Return the organization reader."""
+        ...
+
+    @property
+    def projects(self) -> CollectionReader[Project, UUID]:
+        """Return the project reader."""
+        ...
+
+    @property
+    def datasets(self) -> CollectionReader[Dataset, UUID]:
+        """Return the dataset reader."""
+        ...
+
+
+class HierarchyFacts(CatalogReaders, Protocol):
+    """Internal classification and parent facts needed before discovery is decided."""
+
+    async def project_visibilities(self) -> list[ProjectVisibility]:
+        """Return every project's identity, organization and classification.
+
+        Returns:
+            Current project facts without a visibility filter.
+        """
+        ...
+
+    async def dataset_parents(self, dataset_ids: frozenset[UUID]) -> dict[UUID, UUID]:
+        """Resolve the parents of exactly the requested dataset grants.
+
+        Args:
+            dataset_ids: Dataset identifiers mentioned by current bindings.
+
+        Returns:
+            Existing dataset identifiers mapped to their owning projects.
+        """
+        ...
+
+
+class BindingFacts(Protocol):
+    """Current human grants and service-account authority used by authorization."""
+
+    async def bindings_for(self, identifiers: frozenset[str]) -> tuple[Binding, ...]:
+        """Return the compiled capability bindings held by any of the identifiers.
+
+        This is the read ``decide()`` consumes. The result has the shape
+        ``compile_binding`` produces: for each stored grant, one binding
+        carrying the role's control-plane capabilities plus one binding per
+        layer-scoped capability with that grant's ``layers``. Scope
+        inheritance and the expiry check at decision time belong to
+        ``decide()``, so an implementation applies neither - it may only
+        drop bindings that have already expired. Order carries no meaning.
+
+        Args:
+            identifiers: The caller's ``user:`` and ``group:`` identifiers;
+                a binding is included when its principal is any of them.
+
+        Returns:
+            Every matching binding, or an empty tuple when ``identifiers``
+            is empty or nothing is bound to any of them.
+        """
+        ...
+
+    async def service_account_by_subject(self, subject: str) -> ServiceAccount:
+        """Return one service account by its principal subject.
+
+        This is the lookup authorization makes for an authenticated ``sa:``
+        caller, so it must return a disabled account too - the caller
+        decides what ``disabled_at`` means. A subject that names no service
+        account raises ``ResourceNotFound``.
+
+        Args:
+            subject: The principal subject the account authenticates as.
+
+        Returns:
+            The stored account.
+        """
+        ...
diff --git a/src/huron/pkg/metastore/queries.py b/src/huron/pkg/metastore/queries.py
new file mode 100644
index 0000000..f988a0e
--- /dev/null
+++ b/src/huron/pkg/metastore/queries.py
@@ -0,0 +1,163 @@
+"""Private typed execution for fixed discoverable catalog projections."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from huron.pkg.catalog.errors import ResourceNotFound
+from huron.pkg.catalog.persistence import PlatformRoot, Window
+from huron.pkg.catalog.records import Dataset, Organization, Project
+
+from . import rows
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+    from uuid import UUID
+
+    import asyncpg
+
+    from huron.pkg.rbac import Visibility
+
+
+@dataclass(frozen=True)
+class _Projection[ItemT]:
+    """A trusted SQL selection and its explicit record decoder."""
+
+    selection: str
+    decode: Callable[[asyncpg.Record], ItemT]
+    kind: str
+
+
+_ORGANIZATIONS = _Projection[Organization](
+    """SELECT o.id, o.slug, o.title, o.description, o.generation, o.version, o.created_at
+    FROM organizations o
+    WHERE ($1::boolean OR o.id = ANY($2::uuid[])
+      OR EXISTS (SELECT 1 FROM projects p
+                 WHERE p.organization_id = o.id AND p.id = ANY($3::uuid[]))
+      OR EXISTS (SELECT 1 FROM datasets d JOIN projects p ON p.id = d.project_id
+                 WHERE p.organization_id = o.id AND d.id = ANY($4::uuid[])))""",
+    rows.organization,
+    "organization",
+)
+_PROJECTS = _Projection[Project](
+    """SELECT p.id, p.organization_id, p.slug, p.title, p.description,
+              p.classification_default, p.generation, p.version, p.created_at
+    FROM projects p
+    WHERE ($1::boolean OR p.id = ANY($3::uuid[])
+      OR EXISTS (SELECT 1 FROM datasets d
+                 WHERE d.project_id = p.id AND d.id = ANY($4::uuid[])))
+      AND $2::uuid[] IS NOT NULL""",
+    rows.project,
+    "project",
+)
+_DATASETS = _Projection[Dataset](
+    """SELECT d.id, d.project_id, d.slug, d.title, d.description, d.profile_name,
+              d.profile_version, d.entry_layer, d.lifecycle_state,
+              d.generation, d.version, d.created_at
+    FROM datasets d
+    WHERE ($1::boolean OR d.project_id = ANY($3::uuid[]) OR d.id = ANY($4::uuid[]))
+      AND $2::uuid[] IS NOT NULL""",
+    rows.dataset,
+    "dataset",
+)
+
+
+class _PostgresCollection[ItemT, ParentT]:
+    """Required lookup and bounded keyset execution for a fixed visible selection."""
+
+    def __init__(
+        self, pool: asyncpg.Pool, projection: _Projection[ItemT], parent_column: str | None
+    ) -> None:
+        """Bind trusted selection and parent column once at adapter construction.
+
+        Args:
+            pool: The connection pool owned by application wiring.
+            projection: Fixed SQL and explicit decoder for this collection.
+            parent_column: Fixed parent column, absent at the platform root.
+        """
+        self._pool = pool
+        self._projection = projection
+        self._parent_column = parent_column
+
+    async def get(self, resource_id: UUID, visibility: Visibility) -> ItemT:
+        """Return an admitted record or raise the same error as an absent record.
+
+        Args:
+            resource_id: The exact entity identifier.
+            visibility: Discovery rights evaluated inside SQL.
+
+        Returns:
+            The decoded entity.
+
+        Raises:
+            ResourceNotFound: If the selection admits no matching row.
+        """
+        row = await self._pool.fetchrow(
+            f"SELECT * FROM ({self._projection.selection}) visible WHERE id = $5 LIMIT 1",
+            *_visibility_parameters(visibility),
+            resource_id,
+        )
+        if row is None:
+            raise ResourceNotFound(f"{self._projection.kind} does not exist: {resource_id}")
+        return self._projection.decode(row)
+
+    async def browse(
+        self,
+        parent: ParentT,
+        visibility: Visibility,
+        *,
+        limit: int,
+        after: tuple[str, UUID] | None,
+    ) -> Window[ItemT]:
+        """Fetch at most limit plus one visible records in C-collated cursor order.
+
+        Args:
+            parent: The owning identifier or platform root.
+            visibility: Discovery rights evaluated before LIMIT.
+            limit: Maximum returned records.
+            after: Exclusive slug and UUID cursor.
+
+        Returns:
+            A typed page and visible further-row flag.
+        """
+        after_slug, after_id = after if after is not None else (None, None)
+        parent_filter = (
+            f"{self._parent_column} = $5::uuid"
+            if self._parent_column is not None
+            else "$5::uuid IS NULL"
+        )
+        fetched = await self._pool.fetch(
+            f"""SELECT * FROM ({self._projection.selection}) visible
+            WHERE {parent_filter}
+              AND ($6::text IS NULL OR (slug COLLATE "C", id) > ($6 COLLATE "C", $7::uuid))
+            ORDER BY slug COLLATE "C", id LIMIT $8""",
+            *_visibility_parameters(visibility),
+            None if isinstance(parent, PlatformRoot) else parent,
+            after_slug,
+            after_id,
+            limit + 1,
+        )
+        return Window(
+            items=[self._projection.decode(row) for row in fetched[:limit]],
+            has_more=len(fetched) > limit,
+        )
+
+
+def _visibility_parameters(
+    visibility: Visibility,
+) -> tuple[bool, list[UUID], list[UUID], list[UUID]]:
+    """Bind the same visibility facts to each trusted projection.
+
+    Args:
+        visibility: The caller's current discovery facts.
+
+    Returns:
+        Unrestricted admission and organization, project, dataset grants.
+    """
+    return (
+        visibility.unrestricted,
+        list(visibility.organization_ids),
+        list(visibility.project_ids),
+        list(visibility.dataset_ids),
+    )
