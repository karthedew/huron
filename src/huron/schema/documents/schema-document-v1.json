{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huron.dev/schemas/schema-document-v1.json",
  "title": "Huron metadata schema document",
  "description": "The subset of JSON Schema 2020-12 that Huron metadata schemas may use.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "const": "object"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/property"
      }
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "additionalProperties": {
      "type": "boolean"
    }
  },
  "required": [
    "type"
  ],
  "$defs": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "const": {},
        "default": {},
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "format": {
          "enum": [
            "date",
            "date-time",
            "email",
            "uri"
          ]
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "items": {
          "$ref": "#/$defs/property"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/property"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/property"
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    }
  }
}
